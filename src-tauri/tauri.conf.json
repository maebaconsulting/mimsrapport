{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIMS REPORTING",
  "version": "0.1.1",
  "identifier": "com.maeba.reporting-manar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MIMS REPORTING",
        "width": 1280,
        "height": 832,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/pocketbase"],
    "resources": {
      "../pocketbase/pb_migrations": "pb_migrations"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
